		(date "2026-08-01")
		(rev "1")
		(company "Zaba505/embedded")
		(comment 1 "Rover build only. The base populates DS1 and its three drivers and nothing else.")
		(comment 2 "Drives #53: three states, hole classification, and a positional claim that is never binary.")
		(comment 3 "SCS on the memory LCD is ACTIVE HIGH. The card on the same bus is active low.")
		(comment 4 "All LED and buzzer current is drawn from +5V through low-side switches, never from a Due pin.")
