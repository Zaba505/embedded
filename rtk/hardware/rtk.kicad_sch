		(title "RTK survey system - overview, shared decisions and electrical ceilings")
		(date "2026-08-01")
		(rev "1")
		(company "Zaba505/embedded")
		(comment 1 "Two nodes: a permanently mounted base station and a hand-pushed rover cart.")
		(comment 2 "Receiver: u-blox ZED-F9P (UBX-21044850 R05). Antenna: u-blox ANN-MB-00 (UBX-18049862 R05).")
		(comment 3 "Radio: Digi XBee-PRO 900HP S3B (90002173 rev N). Logger: Arduino Due / SAM3X8E (Atmel-11057C).")
		(comment 4 "No firmware in this story. Every later story implements against these sheets.")
